<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cleared and then set to nuget.org alone, so a feed configured on the machine - a local
       folder holding a package built from this working tree, most of all - cannot satisfy the
       reference and turn this suite into a second run of the unit tests. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
